# Supabaseのプロジェクト画面(Settings > API Keys)から取得して、
# このファイルを .env.local という名前でコピーし、値を埋めてください。
# .env.local はGitにはコミットしないでください(.gitignoreに入っています)。

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# サーバー側(APIルート)だけで使う、公開してはいけないキー。
# OCR用にClaude APIを呼び出す処理などで、発注データを書き込む際に使用する想定。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# AI-OCR(発注データ取込)で使用。console.anthropic.com で取得する。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
